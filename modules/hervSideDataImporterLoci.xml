<?xml version="1.0" encoding="UTF-8" standalone="no"?>

<textFilePopulator>

    <columnDelimiterRegex>\t</columnDelimiterRegex>
    
    <textFileColumn>
        <identifier>true</identifier>
        <header>sequenceID</header>
        <property>sequenceID</property>
    </textFileColumn>

    <textFileColumn>
        <header>Classification</header>
        <property>raw_classification</property>
    </textFileColumn>

    <textFileColumn>
        <header>Scaffold</header>
        <property>locus_data.scaffold</property>
    </textFileColumn>

    <textFileColumn>
        <header>Start</header>
        <property>locus_data.start_position</property>
    </textFileColumn>

    <textFileColumn>
        <header>End</header>
        <property>locus_data.end_position</property>
    </textFileColumn>

    <skipMissing>true</skipMissing>

</textFilePopulator>

