        <identifier>true</identifier>
        <header>sequenceID</header>
        <property>sequenceID</property>
    </textFileColumn>
    
    <textFileColumn>
        <header>subfamily</header>
        <property>subfamily</property>
    </textFileColumn>
         
    <textFileColumn>
        <header>genus</header>
        <property>genus</property>
    </textFileColumn>
    
    <textFileColumn>
        <header>subgenus</header>
        <property>subgenus</property>
    </textFileColumn>
    
    <textFileColumn>
        <header>full_name</header>
        <property>full_name</property>
    </textFileColumn>
    

    <skipMissing>true</skipMissing>
</textFilePopulator>
