<figTreeAnnotationExporter>

	<figTreeAnnotation>
		<annotationName>sequenceID</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.sequenceID')}</valueFreemarkerTemplate>
	</figTreeAnnotation>
	
	<figTreeAnnotation>
		<annotationName>erv_lineage</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.erv_lineage.rv_species.id')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>species</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.xrv_isolate.rv_species.id')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>name</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.xrv_isolate.rv_species.name')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>full_name</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.xrv_isolate.rv_species.full_name')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>clade</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.erv_lineage.rv_species.rv_clade.id')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>genus</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.erv_lineage.rv_species.rv_genus.id')}</valueFreemarkerTemplate>
	</figTreeAnnotation>
	
	<figTreeAnnotation>
		<annotationName>combined-erv-xrv-species</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.xrv_isolate.rv_species.id')}|${renderNestedProperty('sequence.erv_lineage.rv_species.id')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	<figTreeAnnotation>
		<annotationName>combined-erv-xrv-name</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.xrv_isolate.rv_species.name')}|${renderNestedProperty('sequence.erv_lineage.rv_species.name')}</valueFreemarkerTemplate>
	</figTreeAnnotation>
	
	<figTreeAnnotation>
		<annotationName>combined-erv-xrv-genus</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.xrv_isolate.rv_species.rv_genus.id')}|${renderNestedProperty('sequence.erv_lineage.rv_species.rv_genus.id')}</valueFreemarkerTemplate>
	</figTreeAnnotation>
	
	<figTreeAnnotation>
		<annotationName>combined-erv-xrv-subgenus</annotationName>
		<valueFreemarkerTemplate>${renderNestedProperty('sequence.xrv_isolate.rv_species.rv_subgenus.id')}|${renderNestedProperty('sequence.erv_lineage.rv_species.rv_subgenus.id')}</valueFreemarkerTemplate>
	</figTreeAnnotation>

	
</figTreeAnnotationExporter>

