<?xml version="1.0" encoding="UTF-8" standalone="no"?>

<textFilePopulator>

    <columnDelimiterRegex>\t</columnDelimiterRegex>
    
    <textFileColumn>
        <identifier>true</identifier>
        <header>idx</header>
        <property>sequenceID</property>
    </textFileColumn>

    <textFileColumn>
        <header>chrom</header>
        <property>locus_data.scaffold</property>
    </textFileColumn>

    <textFileColumn>
        <header>strand</header>
        <property>locus_data.orientation</property>
    </textFileColumn>

    <textFileColumn>
        <header>start</header>
        <property>locus_data.start_position</property>
    </textFileColumn>

    <textFileColumn>
        <header>end</header>
        <property>locus_data.end_position</property>
    </textFileColumn>

    <skipMissing>true</skipMissing>

</textFilePopulator>

