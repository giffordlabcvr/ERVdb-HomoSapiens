delete module fastaAlignmentExporterLineage

# Export recursively populated clade MSAs

create module -f modules/build/rv/fastaAlignmentExporterLineage.xml
module fastaAlignmentExporterLineage 

  export AL_ROOT_CLADE_I -r REF_MLV -f pol -a -c -e \
	     -o alignments/recursive_root/AL_ROOT_CLADE_I.fna
    
  export AL_ROOT_CLADE_II -r REF_ALV -f pol -a -c -e \
	     -o alignments/recursive_root/AL_ROOT_CLADE_II.fna

  export AL_ROOT_CLADE_III -r REF_SFVcpz -f pol -a -c -e \
	     -o alignments/recursive_root/AL_ROOT_CLADE_III.fna

  exit