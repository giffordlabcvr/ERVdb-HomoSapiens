list custom-table-row erv_lineage \
                 sequence.sequenceID \
                 sequence.source.name \
                 reference_type \ 
                 reference_method \
                 num_seqs \
                 consensus_orfs \
                 in_rt_phylogeny \
                 in_tm_phylogeny \
                 pubmed_id
     
list sequence sequenceID \
              rv_species.full_name \
              sequence_kind length \
              rv_clade.id \
              rv_subfamily.id \
              rv_genus.id \
              rv_subgenus.id \ 
              erv_lineage.reference_type \
              erv_lineage.reference_method \
              erv_lineage.num_seqs \
              erv_lineage.accession \
              erv_lineage.pubmed_id \
              erv_lineage.in_rt_phylogeny \
              erv_lineage.in_tm_phylogeny \
              erv_lineage.consensus_orfs \
              -w "source.name != 'erv-refseqs-ltr'"
              