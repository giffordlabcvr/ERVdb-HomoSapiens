
console set cmd-output-file-format tab

# LTR-lineage associations.
console set next-cmd-output-file web-app/hg19_locus_ltr_assoc.tsv
list custom-table-row erv_locus_ltr_assoc \
  -w "erv_locus.genome_build = 'hg19'" \
  -s id \
  id \
  erv_locus.id \
  ltr_lineage.id \
  association_role \
  evidence \
  confidence \
  region_start \
  region_end

