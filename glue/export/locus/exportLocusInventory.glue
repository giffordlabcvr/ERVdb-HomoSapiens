
console set cmd-output-file-format tab

# Principal locus inventory.
console set next-cmd-output-file web-app/hg19_loci_ervdb.tsv
list custom-table-row erv_locus \
  -w "genome_build = 'hg19'" \
  -s id \
  id \
  missillac_id \
  orthology_group \
  host_species \
  genome_build \
  scaffold \
  start_position \
  end_position \
  orientation \
  locus_type \
  structural_profile \
  is_mosaic \
  taxonomic_resolution \
  is_high_support \
  curation_tier \
  sequence.source.name \
  sequence.sequenceID \
  sequence.length

