
console set cmd-output-file-format tab

# Principal locus inventory.
console set next-cmd-output-file web-app/hg19_loci_ervdb.tsv
list custom-table-row erv_locus \
  -w "genome_build = 'hg19'" \
  -s id \
  id \
  host_species \
  genome_build \
  scaffold \
  start_position \
  end_position \
  orientation \
  locus_type \
  structural_profile \
  is_mosaic \
  taxonomic_resolution \
  is_high_support \
  curation_tier \
  orthology_group \
  missillac_id \
  sequence.source.name \
  sequence.sequenceID \
  sequence.length

# Internal-lineage associations.
console set next-cmd-output-file web-app/locus/hg19_locus_lineage_assoc.tsv
list custom-table-row erv_locus_lineage_assoc \
  -w "erv_locus.genome_build = 'hg19'" \
  -s id \
  id \
  erv_locus.id \
  erv_lineage.id \
  association_role \
  evidence \
  confidence \
  region_start \
  region_end

# LTR-lineage associations.
console set next-cmd-output-file web-app/hg19_locus_ltr_assoc.tsv
list custom-table-row erv_locus_ltr_assoc \
  -w "erv_locus.genome_build = 'hg19'" \
  -s id \
  id \
  erv_locus.id \
  ltr_lineage.id \
  association_role \
  evidence \
  confidence \
  region_start \
  region_end

# Locus aliases.
console set next-cmd-output-file web-app/erv_locus_alias.tsv
list custom-table-row erv_locus_alias \
  -w "erv_locus.genome_build = 'hg19'" \
  -s id \
  id \
  erv_locus.id \
  alias_name \
  alias_source
  
  
#run file glue/export/exportErvLocusAlignments.js