# Export lineage data

console set cmd-output-file-format tab
console set next-cmd-output-file web-app/erv_lineage_data.tsv

list custom-table-row erv_locus_lineage_assoc \
  erv_locus.id \
  erv_locus.missillac_id \
  erv_lineage.id \
  erv_locus.scaffold \
  erv_locus.start_position \
  erv_locus.end_position \
  erv_locus.orientation \
  erv_locus.locus_type \
  erv_locus.structural_profile \
  erv_locus.taxonomic_resolution \
  erv_lineage.rv_clade.id \
  erv_lineage.rv_genus.id \
  erv_lineage.rv_subgenus.id \
  erv_locus.host_species \
  erv_locus.genome_build \
  association_role \
  evidence \
  confidence \
  region_start \
  region_end \
  -w "erv_locus.is_mosaic = false" \
  -s erv_locus.scaffold,erv_locus.start_position

