  run file glue/build/erv/feature_locations/zeta/HERV-Fc.glue
  run file glue/build/erv/feature_locations/zeta/HERV-XA.glue
  run file glue/build/erv/feature_locations/zeta/HERV-H.glue
  run file glue/build/erv/feature_locations/zeta/HERV-W.glue
  run file glue/build/erv/feature_locations/zeta/HERV-9.glue
