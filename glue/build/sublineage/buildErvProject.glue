# Build endogenous retrovirus component
project ervdb

  # Import ERV lineage reference sequences
  run file glue/build/erv/ervImportReferenceSources.glue

  # Link reference sequences to lineage/ltr custom tables as appropriate
  run script glue/build/erv/ervLinkReferences.js

  # Set reference sequence lengths and kinds
  run script glue/build/erv/setErvSequenceLengthsAndKinds.js 

  # Build the rv_taxonomy table and link the erv lineages to it
  run script glue/build/erv/loadErvTaxonomy.js
  
  # Populate the lineage aliases table 
  run script glue/build/erv/loadErvLineageAliases.js

  # Map ERV lineage and LTR relationships
  #run script glue/build/erv/loadErvLtrRelationships.js

  # Import ERV lineage-specific data
  run file glue/build/erv/ervImportSideData.glue
  
  # Declare reference sequences for ERV lineages
  run script glue/build/erv/ervDeclareReferences.js

  # Import reference feature locations
  run file glue/build/erv/ervImportReferenceFeatureLocations.glue

  # Add ERV reference sequences to constrained alignment tree
  run script glue/build/erv/ervBuildAlignmentTree.js  

  # Import unconstrained ERV-and-XRV alignments
  #run file glue/build/erv/ervImportUncAlignments.glue
  
  # Derive constrained alignments from unconstrained alignments
  #run file glue/build/erv/ervDeriveConstrainedMsas.glue

  # Record feature coverage in constrained alignments
  #run file glue/build/erv/ervRecordFeaturePresence.glue
  
  validate
  
  exit
