
  # Genuine ERV sublineages

  # Create ERV sublineage rows, populate their metadata and taxonomy,
  # and link representative sequences from source erv_sub
  run script glue/build/reference/sublineage/loadErvSublineages.js

  # Populate aliases for the ERV sublineages
  run script glue/build/reference/sublineage/loadErvSublineageAliases.js
  
  # Load LTR lineages associated with ERV sublineages,
  # link their representative sequences from source ltr_sub,
  # and create ERV-sublineage-to-LTR associations
  run script glue/build/reference/sublineage/loadSublineageAssociatedLtrLineages.js
  

