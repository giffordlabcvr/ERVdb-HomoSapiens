  # Extended ERV reference layer

  # Import reference sequences for entities below/outside
  # the canonical ERV lineage layer
  run file glue/build/reference/importExtendedRefSources.glue
  
  # Set reference-sequence lengths and kinds
  run script glue/build/reference/setExtendedRefSequenceLengthsAndKinds.js

  # Load ERV sublineage data
  run file glue/build/reference/sublineage/buildSublineageLayer.glue
    
  # Load ERV-derived repeat data
  run file glue/build/reference/ervr/buildErvrLayer.glue

  # Declare reference sequences for ERV sublineages and their LTRs
  run script glue/build/reference/ervDeclareSublineageReferences.js

  # Set LTR lengths and add feature locations
  run script glue/build/reference/addLtrWholeGenomeFeatureLocations.js
  
  # Import sublineage reference feature locations
  run file glue/build/reference/importSublineageFeatureLocations.glue
  
  # Extend the constrained alignment tree
  #run script glue/build/reference/sublineage/extendAlignmentTreeAcceptedSublineages.js
   
  # Summarise the completed sublineage layer
  #run script glue/build/reference/summariseReferenceExtensionLayer.js
  
  validate


