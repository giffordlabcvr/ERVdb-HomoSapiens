
  # Import reference sequence data from GenBank XML
  create module -f modules/build/locus/hervSideDataImporterLoci.xml
  
  module hervSideDataImporterLoci
    populate -f tabular/locus/merge/herv8K/fr_rt4_samerow.tsv
    populate -f tabular/locus/merge/herv8K/fr_samename.tsv
    populate -f tabular/locus/merge/herv8K/fr_only1id.tsv
    populate -f tabular/locus/merge/herv8K/fr_harlequin.tsv
    
    populate -f tabular/locus/merge/herv8K/r_rt4_phyloname.tsv
    populate -f tabular/locus/merge/herv8K/r_rt4_phylogroup.tsv
    populate -f tabular/locus/merge/herv8K/r_rt4_phylosubgroup.tsv
    populate -f tabular/locus/merge/herv8K/r_rt4_phyloclade.tsv

    populate -f tabular/locus/merge/herv8K/r-mosiac-grp-subgrp-ur-notinrt4.tsv
    populate -f tabular/locus/merge/herv8K/r-phyloclade-ur-notinrt4.tsv
    populate -f tabular/locus/merge/herv8K/r-phylogroup-ur-notinrt4.tsv
    populate -f tabular/locus/merge/herv8K/r-phyloname-ur-notinrt4.tsv
    populate -f tabular/locus/merge/herv8K/r-phylosubgrp-ur-notinrt4.tsv
    populate -f tabular/locus/merge/herv8K/ur-notinrt4.tsv
    exit
  
  # Populate additional fields dynamically via script
  run script glue/build/hervPopulateLocusFields.js
