
  # Import classified HERV loci
  run file glue/build/locus/hervImportSources.glue

  # Set lengths
  run script glue/build/locus/hervSetSequenceLengthsAndKinds.js 

  # Link to locus data table
  run script glue/build/locus/hervLinkSeqsToLocusTable.js

  # Import metadata about loci from tabular 
  run file glue/build/locus/hervImportSideData.glue

  # Link loci to curated ERV provirus lineage concepts
  run script glue/build/locus/hervLinkLociToErvLineages.js

  # Link loci to curated LTR lineage concepts
  run file glue/build/locus/constructLineageMsas.glue

  # Assign Missillac IDs
  run file glue/build/locus/assignMissillacIds.glue

  # Map legacy ERV overlaps

  validate
