
  # Import the selected and classified HERV locus sequences.
  # The source dataset is too large to include in this GitHub repository.
  # Replace the path below with the location of the dataset on your computer.
  import source sources/filtered_2026_07
    
  # Load the source candidate dataset
  run script glue/build/locus/candidates/loadErvLocusCandidates.js

  # Set locus sequence lengths and kinds
  run script glue/build/locus/setLocusSeqLengthsAndKinds.js
  
  # Create permanent erv_locus rows from selected candidates,
  # populate their metadata, and link the imported sequences
  run script glue/build/locus/loadErvLoci.js

  # Create curated locus-to-ERV-lineage associations
  run script glue/build/locus/loadErvLocusLineageAssociations.js

  # Create curated locus-to-LTR-lineage associations, where available
  run script glue/build/locus/loadErvLocusLtrAssociations.js
  
  # Load source-specific provenance records and connect them to
  # the resolved ERV loci
  #run file glue/build/locus/loadErvLocusProvenance.glue

  # Add resolved locus sequences to their lineage/sublineage alignments
  run script glue/build/locus/msa/addResolvedLociToAlignments.js
  
  # Compute ERV lineage and sublineage alignments
  run script glue/build/locus/msa/computeHervLineageAlignments.js

  # Compute LTR-lineage alignments
  run script glue/build/locus/msa/computeHervLineageLtrAlignments.js

  # Record feature presence in the resulting alignments
  run file glue/build/locus/msa/recordFeaturePresence.glue

  # Import legacy mappings used for Missillac nomenclature
  run file glue/build/locus/missillac/importLegacyMappings.glue

  # Assign Missillac identifiers and orthology-group numbers to
  # lineage-resolved ERV loci
  run script glue/build/locus/missillac/applyErvLocusNames.js

  # Summarise and check the completed locus layer
  run script glue/build/locus/summariseErvLocusLayer.js

  validate
  
