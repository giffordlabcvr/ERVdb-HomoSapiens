
  # Add imported ERV loci to lineage-level alignments
  run script glue/build/locus/addHervLociToLineageAlignments.js

  # Compute lineage-level alignments
  run script glue/build/locus/computeHervLineageAlignments.js
  
  # Record feature presence in alignment members
  run file glue/build/locus/hervRecordFeaturePresence.glue
