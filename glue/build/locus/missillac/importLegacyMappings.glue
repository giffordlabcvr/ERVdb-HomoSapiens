module legacyLocusImporter invoke-function loadLegacyLocusFile \
    tabular/locus/legacy/dbm-gifford-legacy-list-hg19.tsv \
    compiled_human_erv_loci_hg19 \
    null \
    "Homo sapiens" \
    hg19 \
    false

