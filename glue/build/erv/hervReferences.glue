  ### Declare ERV reference sequencess
    	
  ## Betaretrovirus
  create reference REF_HERVK_HML2          erv-refseqs-beta HERVK-HML2
  create reference REF_HERVK_HML1          erv-refseqs-beta HERVK-HML1
  create reference REF_HERVK_HML3          erv-refseqs-beta HERVK-HML3
  create reference REF_HERVK_HML4          erv-refseqs-beta HERVK-HML4
  create reference REF_HERVK_HML5          erv-refseqs-beta HERVK-HML5
  create reference REF_HERVK_HML6          erv-refseqs-beta HERVK-HML6
  create reference REF_HERVK_HML7          erv-refseqs-beta HERVK-HML7
  create reference REF_HERVK_HML8          erv-refseqs-beta HERVK-HML8
  create reference REF_HERVK_HML9          erv-refseqs-beta HERVK-HML9
  create reference REF_HERVK_HML10         erv-refseqs-beta HERVK-HML10

  ## Gammaretrovirus
  create reference REF_HERVT               erv-refseqs-gamma HERV-T
  create reference REF_HERVE               erv-refseqs-gamma HERV-E
  create reference REF_HERVR               erv-refseqs-gamma HERV-R
  
  ## Rhoretrovirus 
  create reference REF_HERVRb              erv-refseqs-rho HERV-Rb 

  ## Iotaretrovirus
  create reference REF_HERVI               erv-refseqs-iota HERV-I

  ## Zetaretrovirus
  create reference REF_HERVFc              erv-refseqs-zeta HERV-Fc
  create reference REF_HERVFb              erv-refseqs-zeta HERV-Fb
  create reference REF_HERVH               erv-refseqs-zeta HERV-H
  create reference REF_HERVXA              erv-refseqs-zeta HERV-XA
  create reference REF_HERV9               erv-refseqs-zeta HERV-9
  create reference REF_HERVW               erv-refseqs-zeta HERV-W

  ## Thetaretrovirus
  create reference REF_HERVLb              erv-refseqs-theta HERV-Lb

  ## Lambdaretrovirus
  create reference REF_HERVL               erv-refseqs-lambda HERV-L
  create reference REF_HERVU3              erv-refseqs-lambda HERV-U3

  ## Sigmaretrovirus
  create reference REF_HERVS               erv-refseqs-sigma HERV-S

