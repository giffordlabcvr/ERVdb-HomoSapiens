 
  #~# Build major clade level phylogenies
  
  # Clade I

  module ervRaxmlPhylogenyGeneratorNucs

	generate nucleotide phylogeny AL_ROOT_CLADE_I \
	  -r REF_MLV \
	  -f pol \
	  -c \
	  -w "alignment.reference_set = true and sequence.sequenceID != 'HERV-Fc1'" \
	  -o trees/navigator/ervCladeIPolNucs.tree NEWICK_BOOTSTRAPS

  exit

  # Clade II
      
  module ervRaxmlPhylogenyGeneratorNucs

    # Major clade phylogeny is unreliable for clade II
    # due to extreme nuc bias in some genera
    
    # Hence this step is commented out
    #generate nucleotide phylogeny AL_ROOT_CLADE_II \
	#  -r REF_ALV \
	#  -f pol \
	#  -c \
	#  -w "alignment.reference_set = true and sequence.sequenceID != 'MinERVa'" \
	#  -o trees/navigator/ervCladeIIPolNucs.tree NEWICK_BOOTSTRAPS

    # Instead we generate separate trees for the "Alpha-Beta" minor clade
    # as well as separate genus-level trees for lentivirus and deltaretrovirus
	generate nucleotide phylogeny AL_MINOR_CLADE_Alpha_Beta \
	  -r REF_ALV \
	  -f pol \
	  -c \
	  -w "alignment.reference_set = true" \
	  -o trees/navigator/ervAlphaBetaPolNucs.tree NEWICK_BOOTSTRAPS

    generate nucleotide phylogeny AL_GENUS_Lentivirus -s ervSelectorLentiPolNucs \
      -a \
      -o trees/navigator/ervLentiPolNucs.tree NEWICK_BOOTSTRAPS

    generate nucleotide phylogeny AL_GENUS_Deltaretrovirus -s ervSelectorDeltaPolNucs \
      -w "fLocNotes.featureLoc.feature.name = 'pol' and fLocNotes.ref_nt_coverage_pct >= 55" \
      -o trees/navigator/ervDeltaPolNucs.tree NEWICK_BOOTSTRAPS

  exit
 
  # Clade III
  
  module ervRaxmlPhylogenyGeneratorNucs

	generate nucleotide phylogeny AL_ROOT_CLADE_III \
	  -r REF_SFVcpz \
	  -f pol \
	  -c \
	  -w "alignment.reference_set = true" \
	  -o trees/navigator/ervCladeIIIPolNucs.tree NEWICK_BOOTSTRAPS

  exit


