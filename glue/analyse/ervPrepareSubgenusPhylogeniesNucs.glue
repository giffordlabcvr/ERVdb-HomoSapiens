  delete module ervPhyloUtility
  delete module ervFigTreeAnnotationExporterLineage
  
  create module -f modules/analyse/ervPhyloUtility.xml
  create module -f modules/analyse/ervFigTreeAnnotationExporterLineage.xml

  module ervPhyloUtility
  
	# midpoint rooting

	#reroot-phylogeny \
    #  --inputFile trees/subgenus/ervEtaPolNucs.tree NEWICK_BOOTSTRAPS \
    #  --midpoint \
    #  --outputFile trees/subgenus/ervEtaPolNucsMidpointRerootedNucs.tree NEWICK_BOOTSTRAPS

	reroot-phylogeny \
      --inputFile trees/subgenus/ervKappaPolNucs.tree NEWICK_BOOTSTRAPS \
      --midpoint \
      --outputFile trees/subgenus/ervKappaPolNucsMidpointRerootedNucs.tree NEWICK_BOOTSTRAPS

    exit   
  
  # Export annotations
  module ervFigTreeAnnotationExporterLineage
  	export figtree-annotation AL_SUBGENUS_Kappa -f trees/subgenus/AL_SUBGENUS_Kappa.annotations.tsv
  	export figtree-annotation AL_SUBGENUS_Eta -f trees/subgenus/AL_SUBGENUS_Eta_annotations.tsv

    exit   
