 
  #~# Build lineage level phylogenies
  
  
  module ervRaxmlPhylogenyGeneratorNucs

  # Clade I

    #~# Gammaretroviruses
    generate nucleotide phylogeny AL_LINEAGE_HERVT  -s ervSelectorHervTGenomeNucs -a -o trees/lineage/hervTNucs.tree NEWICK_BOOTSTRAPS
    generate nucleotide phylogeny AL_LINEAGE_HERVE  -s ervSelectorHervEGenomeNucs -a -o trees/lineage/hervENucs.tree NEWICK_BOOTSTRAPS
    generate nucleotide phylogeny AL_LINEAGE_HERVR  -s ervSelectorHervRGenomeNucs -a -o trees/lineage/hervRNucs.tree NEWICK_BOOTSTRAPS

    #~# Rhoretroviruses
    generate nucleotide phylogeny AL_LINEAGE_HERVRb -s ervSelectorHervRbGenomeNucs -a -o trees/lineage/hervRbNucs.tree NEWICK_BOOTSTRAPS

    #~# Iotaretroviruses
    generate nucleotide phylogeny AL_LINEAGE_HERVI -s ervSelectorHervIGenomeNucs -a -o trees/lineage/hervINucs.tree NEWICK_BOOTSTRAPS

    #~# Zetaretroviruses (H/F)  
    generate nucleotide phylogeny AL_LINEAGE_HERVH -s ervSelectorHervHGenomeNucs -a -o trees/lineage/hervHNucs.tree NEWICK_BOOTSTRAPS
    generate nucleotide phylogeny AL_LINEAGE_HERVFa -s ervSelectorHervFaGenomeNucs -a -o trees/lineage/hervFaNucs.tree NEWICK_BOOTSTRAPS
    generate nucleotide phylogeny AL_LINEAGE_HERVFb -s ervSelectorHervFbGenomeNucs -a -o trees/lineage/hervFbNucs.tree NEWICK_BOOTSTRAPS
    generate nucleotide phylogeny AL_LINEAGE_HERVFc -s ervSelectorHervFcGenomeNucs -a -o trees/lineage/hervFcNucs.tree NEWICK_BOOTSTRAPS

    #~# Zetaretroviruses  (W/9/30)  
    generate nucleotide phylogeny AL_LINEAGE_HERVW -s ervSelectorHervWGenomeNucs -a -o trees/lineage/hervWNucs.tree NEWICK_BOOTSTRAPS
    generate nucleotide phylogeny AL_LINEAGE_HERV9 -s ervSelectorHerv9GenomeNucs -a -o trees/lineage/herv9Nucs.tree NEWICK_BOOTSTRAPS


  # Clade II

	#~# Betaretroviruses
    generate nucleotide phylogeny AL_LINEAGE_HERVKHML1 -s ervSelectorHervKhml1GenomeNucs -a -o trees/lineage/hervKhml1Nucs.tree NEWICK_BOOTSTRAPS
    generate nucleotide phylogeny AL_LINEAGE_HERVKHML2 -s ervSelectorHervKhml2GenomeNucs -a -o trees/lineage/hervKhml2Nucs.tree NEWICK_BOOTSTRAPS
    generate nucleotide phylogeny AL_LINEAGE_HERVKHML3 -s ervSelectorHervKhml3GenomeNucs -a -o trees/lineage/hervKhmlsNucs.tree NEWICK_BOOTSTRAPS
    generate nucleotide phylogeny AL_LINEAGE_HERVKHML4 -s ervSelectorHervKhml4GenomeNucs -a -o trees/lineage/hervKhml4Nucs.tree NEWICK_BOOTSTRAPS
    generate nucleotide phylogeny AL_LINEAGE_HERVKHML7 -s ervSelectorHervKhml7GenomeNucs -a -o trees/lineage/hervKhml7Nucs.tree NEWICK_BOOTSTRAPS
    generate nucleotide phylogeny AL_LINEAGE_HERVKHML8 -s ervSelectorHervKhml8GenomeNucs -a -o trees/lineage/hervKhml8Nucs.tree NEWICK_BOOTSTRAPS
    generate nucleotide phylogeny AL_LINEAGE_HERVKHML9 -s ervSelectorHervKhml9GenomeNucs -a -o trees/lineage/hervKhml9Nucs.tree NEWICK_BOOTSTRAPS
    generate nucleotide phylogeny AL_LINEAGE_HERVKHML10 -s ervSelectorHervKhml10GenomeNucs -a -o trees/lineage/hervKhml10Nucs.tree NEWICK_BOOTSTRAPS

	#~# Archaeobetaretroviruses
    generate nucleotide phylogeny AL_LINEAGE_HERVKHML5 -s ervSelectorHervKhml5GenomeNucs -a -o trees/lineage/hervKhml5Nucs.tree NEWICK_BOOTSTRAPS
    generate nucleotide phylogeny AL_LINEAGE_HERVKHML6 -s ervSelectorHervKhml6GenomeNucs -a -o trees/lineage/hervKhml6Nucs.tree NEWICK_BOOTSTRAPS


  # Clade III
  
 	#~# Lambdaretroviruses
    generate nucleotide phylogeny AL_LINEAGE_HERVL  -s ervSelectorHervLGenomeNucs -a -o trees/lineage/hervLNucs.tree NEWICK_BOOTSTRAPS
    generate nucleotide phylogeny AL_LINEAGE_HERVU3 -s ervSelectorHervU3GenomeNucs -a -o trees/lineage/hervU3Nucs.tree NEWICK_BOOTSTRAPS
 
 	#~# Sigmaretroviruses
    generate nucleotide phylogeny AL_LINEAGE_HERVS  -s ervSelectorHervSGenomeNucs -a -o trees/lineage/hervSNucs.tree NEWICK_BOOTSTRAPS

    exit
    
