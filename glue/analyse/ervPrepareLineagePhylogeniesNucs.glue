
  module ervPhyloUtility
  
	# midpoint rooting

	reroot-phylogeny \
      --inputFile trees/lineage/hervTPolNucs.tree NEWICK_BOOTSTRAPS \
      --midpoint \
      --outputFile trees/lineage/hervTPolNucsMidpointRerootedNucs.tree NEWICK_BOOTSTRAPS

 	reroot-phylogeny \
      --inputFile trees/lineage/hervEPolNucs.tree NEWICK_BOOTSTRAPS \
      --midpoint \
      --outputFile trees/lineage/hervEPolNucsMidpointRerootedNucs.tree NEWICK_BOOTSTRAPS

