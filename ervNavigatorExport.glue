# Export data for ERV web application

project ervdb
  
  # Export features, feature locations, and FASTA 
  run script glue/export/ervdbExportReferenceFeatures.js

  # Export reference sequences
  module fastaExporter export -w \
    "sequence_kind = 'erv_ref' or \
     sequence_kind = 'erv_sublineage_ref' or \
     sequence_kind = 'ervr_ref'" \
    -f web-app/erv_reference_seqs.fna

  # Export LTR reference sequences
  module fastaExporter export -w \
    "sequence_kind = 'ltr_ref'" \
    -f web-app/ltr_reference_seqs.fna

  # Export XRV reference sequence data
  run file glue/export/exportXrvSpeciesData.glue
  
  # Export ERV lineage aliases
  run file glue/export/exportErvLineageAliases.glue
   
  # Export ERV LTR lineage associations
  run file glue/export/exportErvLtrLineageAssociations.glue

  # Export ERV lineage data
  run file glue/export/exportErvLineageData.glue
  
  # Export ERV lineage reference sequence data 
  run file glue/export/exportErvLineageReferenceData.glue
  
  # Export age calibration data 
  run script glue/export/exportErvAgeCalibrationsForNavigator.js

  validate
  
  exit
