  
# Build HERV project  
project ervdb

  # Import classified HERV loci
  run file glue/hervImportSources.glue

  # Set lengths
  run script glue/hervSetSequenceLengthsAndKinds.js 

  # Link to locus data table
  run script glue/hervLinkSeqsToLocusTable.js

  # Import metadata about loci from tabular 
  run file glue/hervImportSideData.glue
  run script glue/hervPopulateLocusFields.js

  # Link loci to curated ERV provirus lineage concepts
  run script glue/hervLinkLociToErvLineages.js

  # Link loci to curated LTR lineage concepts
  #run script glue/hervLinkLociToLtrLineages.js

  # Add imported ERV sequences to alignments
  run script glue/addErvLociToLineageAlignments.js

  # Compute alignments
  run script glue/computeErvLineageAlignments.js
  
  # Record feature presence
  #run file glue/hervRecordFeaturePresence.glue

  # Assign Missillac IDs
  #run script glue/hervLegacyLocusAssign.js
  #run script glue/hervAssignIdsToNonLegacyLoci.js
  
  validate
  
  exit

