  
# Build HERV project  
project ervdb

  # Import classified HERV loci
  run file glue/hervImportSources.glue

  # Set lengths
  run script glue/hervSetSequenceLengthsAndKinds.js 

  # Link to locus data table
  run script glue/hervLinkSeqsToLocusTable.js

  # Import metadata about loci from tabular 
  run file glue/hervImportSideData.glue

  # Link loci to curated ERV provirus lineage concepts
  #run script glue/hervLinkLociToErvLineages.js

  # Link loci to curated LTR lineage concepts
  #run file glue/constructLineageMsas.glue

  # Assign Missillac IDs
  #run file glue/assignMissillacIds.glue
  
  validate
  
  exit

