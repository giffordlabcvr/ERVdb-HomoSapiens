  
# Build HERV project  
project ervdb

  # Import classified HERV loci
  run file glue/hervImportSources.glue

  # Set lengths
  run script glue/hervSetSequenceLengths.js 

  # Link to locus data table
  run script glue/hervLinkSeqsToLocusTable.js

  # Import metadata about loci from tabular
  run file glue/hervImportSideData.glue

  # Link locus sequences to retrovirus taxonomy table
  run script glue/hervLinkSeqsToRvTaxTable.js

  # Add imported ERV sequences to alignments
  run file glue/hervAddLocusSeqsToAlignments.glue

  # Assign IDs
  run script glue/hervLegacyLocusAssign.js
  run script glue/hervAssignIdsToNonLegacyLoci.js

  # Compute alignments
  #run file glue/hervComputeAlignments.glue
  
  validate
  
  exit

