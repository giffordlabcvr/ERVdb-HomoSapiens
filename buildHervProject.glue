
# Define project-specific DB schema extensions
schema-project ervdb

  # Permanent locus provenance tables
  run file schema/ervdbProvenanceTables.glue

  # Temporary/staging candidate table
  run file schema/ervdbStagingTables.glue

  exit

# Build ERVdb-HomoSapiens extension to ERVdb project  
project ervdb

  # Incorporate HERV sublineage data
  run file glue/build/sublineage/buildSublineageLayer.glue

  # Incorporate HERV locus data
  #run file glue/build/locus/buildLocusLayer.glue
  
  exit
